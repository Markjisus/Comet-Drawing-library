local function createDrawingsFor(player)
    local d = {}
    d.Box = Drawing.new("Square")
    d.Box.Filled = false
    d.Box.Thickness = Settings.BoxThickness
    d.Box.Transparency = 1
    d.Box.Color = Settings.ColorEnemy

    d.Name = Drawing.new("Text")
    d.Name.Center = true
    d.Name.Outline = true
    d.Name.Size = Settings.TextSize
    d.Name.Color = Settings.ColorText
    d.Name.Text = player.Name

    d.Tracer = Drawing.new("Line")
    d.Tracer.Thickness = 1
    d.Tracer.Transparency = 1
    d.Tracer.Color = Settings.ColorTracer

    d.HealthBarBG = Drawing.new("Square")
    d.HealthBarBG.Filled = true
    d.HealthBarBG.Transparency = 0.6
    d.HealthBarBG.Color = Color3.fromRGB(30, 30, 30)

    d.HealthBar = Drawing.new("Square")
    d.HealthBar.Filled = true
    d.HealthBar.Transparency = 1
    d.HealthBar.Color = Color3.fromRGB(0, 255, 0)

    d.Skeleton = {}
    for i = 1, 16 do
        d.Skeleton[i] = Drawing.new("Line")
        d.Skeleton[i].Thickness = 1
        d.Skeleton[i].Transparency = 1
        d.Skeleton[i].Color = Settings.ColorEnemy
    end

    d.ToolText = Drawing.new("Text")
    d.ToolText.Center = true
    d.ToolText.Outline = true
    d.ToolText.Size = math.max(12, Settings.TextSize - 2)
    d.ToolText.Color = Settings.ColorText

    d.lastScreen = Vector2.new(0, 0)
    d.smoothedScreen = Vector2.new(0, 0)

    ESPStore[player] = d
    return d
end

local function removeDrawingsFor(player)
    local d = ESPStore[player]
    if not d then return end

    for k, obj in pairs(d) do
        if type(obj) == "table" then
            for _, o in pairs(obj) do
                pcall(function()
                    if o and o.Remove then o:Remove() end
                end)
            end
        else
            pcall(function()
                if obj and obj.Remove then obj:Remove() end
            end)
        end
    end
    ESPStore[player] = nil
end

-- 💣 Reset all ESP drawings (your handler only)
local function resetAllDrawings()
    for player, _ in pairs(ESPStore) do
        removeDrawingsFor(player)
    end
    ESPStore = {}
    print("[✅] All ESP drawings deleted.")
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.P then
        resetAllDrawings()
    end
end)

local function isTarget(player)
    if not player or player == LocalPlayer then return false end
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    if Settings.TargetMode == "OtherTeamsOnly" then
        if player.Team == LocalPlayer.Team then
            return false
        end
        return true
    else
        return true
    end
end

local function getPlayerColor(player)
    if player.Team and LocalPlayer.Team and player.Team == LocalPlayer.Team then
        return Settings.ColorFriendly
    else
        return Settings.ColorEnemy
    end
end

for _,p in ipairs(Players:GetPlayers()) do
    if isTarget(p) then
        createDrawingsFor(p)
    end
end

Players.PlayerAdded:Connect(function(p)
    if isTarget(p) then
        createDrawingsFor(p)
    end
end)

Players.PlayerRemoving:Connect(function(p)
    removeDrawingsFor(p)
end)

local frameCounter = 0
RunService.RenderStepped:Connect(function(delta)
    frameCounter = frameCounter + 1
    if Settings.FrameSkip and Settings.FrameSkip > 0 and (frameCounter % (Settings.FrameSkip + 1) ~= 0) then
        return
    end
    
    for _,player in ipairs(Players:GetPlayers()) do
        if not isTarget(player) then
            removeDrawingsFor(player)
        else
            local d = ESPStore[player] or createDrawingsFor(player)
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            if char and hum and hrp then
                local worldPos = hrp.Position
                local screenPos3, onScreen = Camera:WorldToViewportPoint(worldPos)
                -- FIX: Convert Vector3 to Vector2 properly
                local screenPos = Vector2.new(screenPos3.X, screenPos3.Y)
                local dist = (Camera.CFrame.Position - worldPos).Magnitude
                local inRange = dist <= Settings.MaxDistance
                
                if not inRange or not onScreen or not Settings.Enabled then
                    pcall(function()
                        d.Box.Visible = false
                        d.Name.Visible = false
                        d.Tracer.Visible = false
                        d.HealthBar.Visible = false
                        d.HealthBarBG.Visible = false
                        d.ToolText.Visible = false
                        for i=1,#d.Skeleton do
                            d.Skeleton[i].Visible = false
                        end
                    end)
                else
                    -- smoothing
                    if Settings.SmoothMovement then
                        local t = clamp(Settings.SmoothSpeed * delta, 0, 1)
                        d.smoothedScreen = lerpVec2(d.smoothedScreen, screenPos, t)
                        d.lastScreen = screenPos
                    else
                        d.smoothedScreen = screenPos
                        d.lastScreen = screenPos
                    end
                    
                    local color = getPlayerColor(player)
                    
                    -- BOX
                    if Settings.ShowBox then
                        d.Box.Visible = true
                        d.Box.Color = color
                        local scale = clamp(1 + (200 / math.max(dist,50)), 0.6, 10)
                        local w = 50 * scale
                        local h = 80 * scale
                        d.Box.Size = Vector2.new(w, h)
                        d.Box.Position = Vector2.new(d.smoothedScreen.X - w/2, d.smoothedScreen.Y - h/2)
                        d.Box.Thickness = Settings.BoxThickness
                    else
                        d.Box.Visible = false
                    end
                    
                    -- NAME
                    if Settings.ShowName then
                        d.Name.Visible = true
                        d.Name.Text = player.Name
                        d.Name.Size = Settings.TextSize
                        d.Name.Position = Vector2.new(d.smoothedScreen.X, d.smoothedScreen.Y - (d.Box.Size and d.Box.Size.Y/2 + 10 or 40))
                        d.Name.Color = Settings.ColorText
                    else
                        d.Name.Visible = false
                    end
                    
                    -- DISTANCE
                    if Settings.ShowDistance then
                        d.ToolText.Visible = true
                        d.ToolText.Text = tostring(math.floor(dist)) .. "m"
                        d.ToolText.Size = math.max(12, Settings.TextSize - 2)
                        d.ToolText.Position = Vector2.new(d.smoothedScreen.X, d.smoothedScreen.Y + (d.Box.Size and d.Box.Size.Y/2 + 8 or 40))
                        d.ToolText.Color = Settings.ColorText
                    else
                        if not Settings.ShowTools then
                            d.ToolText.Visible = false
                        end
                    end
                    
                    -- TRACER
                    if Settings.ShowTracers then
                        d.Tracer.Visible = true
                        local fromX
                        if Settings.TracerFromBottom then
                            fromX = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
                        else
                            fromX = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                        end
                        d.Tracer.From = fromX
                        d.Tracer.To = Vector2.new(d.smoothedScreen.X, d.smoothedScreen.Y)
                        d.Tracer.Color = Settings.ColorTracer
                    else
                        d.Tracer.Visible = false
                    end
                    
                    -- HEALTH BAR
                    if Settings.ShowHealthBar and hum then
                        local maxHealth = hum.MaxHealth > 0 and hum.MaxHealth or 100
                        local current = hum.Health
                        local pct = clamp(current / maxHealth, 0, 1)
                        
                        d.HealthBarBG.Visible = true
                        d.HealthBar.Visible = true
                        
                        local hbW = Settings.HealthBarWidth
                        local hbH = 8
                        local leftX = d.smoothedScreen.X - (d.Box.Size and d.Box.Size.X/2 or 30) - hbW - 6
                        local topY = d.smoothedScreen.Y - (hbH/2)
                        
                        d.HealthBarBG.Position = Vector2.new(leftX, topY)
                        d.HealthBarBG.Size = Vector2.new(hbW, hbH)
                        d.HealthBarBG.Color = Color3.fromRGB(30,30,30)
                        
                        d.HealthBar.Position = Vector2.new(leftX, topY)
                        d.HealthBar.Size = Vector2.new(math.max(1, math.floor(hbW * pct)), hbH)
                        d.HealthBar.Color = Color3.new(1 - pct, pct, 0)
                    else
                        d.HealthBar.Visible = false
                        d.HealthBarBG.Visible = false
                    end
                    
                    -- TOOL NAME display
                    if Settings.ShowTools then
                        local toolName = ""
                        local charTools = {}
                        for _,child in pairs(player.Character:GetDescendants()) do
                            if child:IsA("Tool") then
                                table.insert(charTools, child.Name)
                            end
                        end
                        if #charTools > 0 then
                            toolName = charTools[1]
                            d.ToolText.Visible = true
                            d.ToolText.Text = toolName
                            d.ToolText.Position = Vector2.new(d.smoothedScreen.X, d.smoothedScreen.Y + (d.Box.Size and d.Box.Size.Y/2 + 22 or 60))
                        end
                    end
                    
                    -- SKELETON - FIXED: Proper Vector3 to Vector2 conversion
                    if Settings.ShowSkeleton then
                        local function getPart(pname)
                            local part = player.Character and player.Character:FindFirstChild(pname)
                            return part and part.Position
                        end
                        
                        local HEAD = getPart("Head")
                        local NECK = getPart("UpperTorso") or getPart("Torso")
                        local LSH = getPart("LeftUpperArm") or getPart("LeftArm")
                        local RSH = getPart("RightUpperArm") or getPart("RightArm")
                        local LEL = getPart("LeftUpperLeg") or getPart("LeftLeg")
                        local REL = getPart("RightUpperLeg") or getPart("RightLeg")
                        local LFL = getPart("LeftLowerArm") or getPart("LeftForearm")
                        local RFL = getPart("RightLowerArm") or getPart("RightForearm")
                        
                        local lines = {
                            {HEAD, NECK},
                            {NECK, LSH},
                            {NECK, RSH},
                            {NECK, LEL},
                            {NECK, REL},
                            {LSH, LFL},
                            {RSH, RFL},
                        }
                        
                        for i,line in ipairs(lines) do
                            local a,b = line[1], line[2]
                            local li = d.Skeleton[i]
                            if a and b then
                                local aS, onA = Camera:WorldToViewportPoint(a)
                                local bS, onB = Camera:WorldToViewportPoint(b)
                                if onA and onB then
                                    li.Visible = true
                                    -- FIX: Convert Vector3 to Vector2 properly
                                    li.From = Vector2.new(aS.X, aS.Y)
                                    li.To = Vector2.new(bS.X, bS.Y)
                                    li.Color = color
                                else
                                    li.Visible = false
                                end
                            else
                                li.Visible = false
                            end
                        end
                        for i = #lines + 1, #d.Skeleton do
                            d.Skeleton[i].Visible = false
                        end
                    else
                        for i=1,#d.Skeleton do
                            d.Skeleton[i].Visible = false
                        end
                    end
                end
            else
                removeDrawingsFor(player)
            end
        end
    end
end)

