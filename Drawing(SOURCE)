local function makeSlider(parent, posY, labelText, settingKey, minV, maxV, step)
    local row = Create("Frame", {
        Parent = parent, 
        Size = UDim2.new(1,-16,0,44), 
        Position = UDim2.new(0,8,0,posY), 
        BackgroundTransparency = 1
    })
    
    Create("TextLabel", {
        Parent = row,
        Position = UDim2.new(0,0,0,0),
        Size = UDim2.new(1,-120,0,18),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = Color3.fromRGB(220,220,220),
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left
    })
    
    local valueLabel = Create("TextLabel", {
        Parent = row,
        Position = UDim2.new(1,-110,0,0),
        Size = UDim2.new(0,110,0,18),
        BackgroundTransparency = 1,
        Text = tostring(Settings[settingKey]),
        TextColor3 = Color3.fromRGB(200,200,200),
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right
    })
    
    local sliderBg = Create("Frame", {
        Parent = row,
        Position = UDim2.new(0,0,0,22),
        Size = UDim2.new(1,0,0,14),
        BackgroundColor3 = Color3.fromRGB(40,40,40)
    })
    
    Create("UICorner", {Parent = sliderBg, CornerRadius = UDim.new(0,6)})
    
    local sliderFill = Create("Frame", {
        Parent = sliderBg,
        Position = UDim2.new((Settings[settingKey]-minV)/(maxV-minV),0,0,0),
        Size = UDim2.new(0,16,1,0),
        BackgroundColor3 = Color3.fromRGB(120,120,120)
    })
    
    Create("UICorner", {Parent = sliderFill, CornerRadius = UDim.new(0,6)})
    
    local function updateFromX(x)
        local rel = clamp((x - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local val = minV + rel * (maxV - minV)
        if step and step > 0 then
            val = math.floor((val / step) + 0.5) * step
        end
        Settings[settingKey] = val
        valueLabel.Text = tostring(math.floor(val*100)/100)
        sliderFill.Position = UDim2.new(rel, 0, 0, 0)
    end
    
    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            updateFromX(input.Position.X)
            local conn
            conn = UserInputService.InputChanged:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseMovement then
                    updateFromX(inp.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(inp)
                if inp.UserInputType == Enum.UserInputType.MouseButton1 then
                    conn:Disconnect()
                end
            end)
        end
    end)
    
    return row
end

